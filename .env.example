# ─── Database (Supabase) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars

# ─── Admin Portal ──────────────────────────────────────────────────────────────
# Username for the /admin/login portal
ADMIN_USERNAME=admin
# Initial password (plain text). After you log in you can change it via the portal.
ADMIN_PASSWORD=Change_Me_On_First_Login!
# Secret used to sign admin JWT tokens (falls back to NEXTAUTH_SECRET if unset)
ADMIN_SECRET=your-admin-jwt-secret-min-32-chars

# ─── Google OAuth (optional) ───────────────────────────────────────────────────
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# ─── YouTube API (optional) ────────────────────────────────────────────────────
YOUTUBE_API_KEY=your-youtube-api-key

# ─── App URL (optional) ────────────────────────────────────────────────────────
NEXT_PUBLIC_URL=http://localhost:3000

# ─── Cron (optional) ───────────────────────────────────────────────────────────
CRON_SECRET=your-cron-secret
