{
  "name": "gazefocus-desktop",
  "productName": "GazeFocus Agent",
  "version": "1.0.0",
  "description": "GazeFocus companion — priority deadline notifications from your GazeFocus scheduling agent",
  "main": "main.js",
  "author": "GazeFocus",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.gazefocus.desktop",
    "productName": "GazeFocus Agent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "login.html"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "runAfterFinish": true,
      "shortcutName": "GazeFocus Agent"
    }
  }
}
